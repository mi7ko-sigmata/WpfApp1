<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Списък с ученици (Inheritance Demo)" Height="450" Width="650"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="15"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Лява колона: Входна форма и бутони -->
        <StackPanel Grid.Column="0">
            <TextBlock Text="Номер в клас:" Margin="0,0,0,2"/>
            <TextBox x:Name="NumberBox" Margin="0,0,0,10" Padding="3"/>

            <TextBlock Text="Име:" Margin="0,0,0,2"/>
            <TextBox x:Name="NameBox" Margin="0,0,0,10" Padding="3"/>

            <TextBlock Text="Оценка:" Margin="0,0,0,2"/>
            <TextBox x:Name="GradeBox" Margin="0,0,0,10" Padding="3"/>

            <Button Content="Добави ученик" Click="AddStudentButton_Click" Height="30" Margin="0,5,0,5"/>
            <Button Content="Запази корекция" Click="EditStudentButton_Click" Height="30" Margin="0,0,0,5"/>
            <Button Content="Изтрий избран" Click="DeleteStudentButton_Click" Height="30" Margin="0,0,0,10" Background="#FFE57373"/>

            <TextBlock x:Name="StatusTextBlock" Foreground="DarkBlue" TextWrapping="Wrap" Margin="0,5,0,0" FontWeight="Bold"/>
        </StackPanel>

        <!-- Дясна колона: Таблица (DataGrid) -->
        <DataGrid x:Name="StudentsDataGrid" Grid.Column="2" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True" 
                  SelectionMode="Single"
                  SelectionChanged="StudentsDataGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding Number}" Width="50"/>
                <DataGridTextColumn Header="Име" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Оценка" Binding="{Binding Grade}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>